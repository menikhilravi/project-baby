# Supabase — Project Settings → API
# Copy to .env.local and fill in values from your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never exposed to the browser. Used by privileged server actions.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret Vercel Cron sends as Authorization: Bearer <this>.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Gemini — for NB-4 LLM name generation
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Web Push (VAPID) — required for ALL push reminders (kick, feed, diaper,
# medicine). sendPush() throws without them, so notifications fail silently
# in the cron logs. Generate a pair with:
#   npx web-push generate-vapid-keys
# Use the same pair everywhere: a device subscribed under one public key is
# rejected by a server holding a different one.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:you@example.com

# Optional reminder tuning (defaults shown).
# CARE_REMINDER_WINDOW=6,22     # quiet hours for feed/diaper nudges
# CARE_DIAPER_HOUR=16           # earliest hour for the daily diaper check
# CARE_MED_GRACE_MIN=120        # how long a missed dose keeps nudging
# KICK_REMINDER_HOURS=2
